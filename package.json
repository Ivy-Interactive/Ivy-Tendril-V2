{
  "name": "ivy-tendril-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "pnpm --filter @ivy-interactive/tendril-app dev",
    "dev:storybook": "pnpm --filter @ivy-interactive/components storybook",
    "build": "pnpm --filter @ivy-interactive/components build && pnpm --filter @ivy-interactive/tendril-app build",
    "build:extension": "pnpm --filter ivy-tendril build",
    "package:extension": "pnpm --filter ivy-tendril package",
    "test:extension": "pnpm --filter ivy-tendril test",
    "typecheck:app": "pnpm --filter @ivy-interactive/tendril-app typecheck",
    "typecheck:extension": "pnpm --filter ivy-tendril typecheck",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r test",
    "test-skills-manifests": "bash scripts/test-skills-manifests.sh",
    "check": "pnpm -r check",
    "check:links": "lychee --config .lychee.toml README*.md docs/**/*.md",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "install:playwright": "playwright install chromium",
    "install:playwright:deps": "playwright install --with-deps chromium",
    "screenshot": "playwright screenshot"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "tsx": "^4.23.13"
  },
  "packageManager": "pnpm@11.25.0"
}
