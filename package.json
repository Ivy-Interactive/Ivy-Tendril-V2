{
  "name": "ivy-tendril-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "pnpm --filter @ivy-interactive/tendril-app dev",
    "dev:storybook": "pnpm --filter @ivy-interactive/components storybook",
    "build": "pnpm --filter @ivy-interactive/components build && pnpm --filter @ivy-interactive/tendril-app build",
    "build:extension": "pnpm --filter tendril-extension build",
    "package:extension": "pnpm --filter tendril-extension package",
    "test:extension": "pnpm --filter tendril-extension test",
    "typecheck:extension": "pnpm --filter tendril-extension typecheck",
    "test": "pnpm -r test",
    "test-skills-manifests": "bash scripts/test-skills-manifests.sh",
    "check": "pnpm -r check",
    "check:links": "lychee --config .lychee.toml README*.md docs/**/*.md",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format"
  },
  "packageManager": "pnpm@11.25.0"
}
