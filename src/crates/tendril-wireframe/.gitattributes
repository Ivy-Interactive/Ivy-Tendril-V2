# The parts of the wireframe payload that are still checked in -- artifacts/fonts/ and the
# fonts.css generated from them. Everything else under artifacts/ is generated at build time and
# git-ignored, so it never passes through git's end-of-line conversion at all.
#
# `-text` disables that conversion entirely, so these files are stored and checked out as the exact
# bytes the pipeline produced. That is not cosmetic: ARTIFACTS.lock.json records a SHA-256 per file,
# the served bundle is hashed against it, and this repository has no root `.gitattributes` while
# contributors on Windows default to `core.autocrlf=true`. Without this rule fonts.css would gain
# CRLF on checkout and its hash in the lock would be wrong. The .woff2 files are binary and would
# be left alone regardless, but naming the whole directory keeps the rule true if a text file is
# ever added beside them.
artifacts/fonts/** -text
artifacts/css/fonts.css -text

# Inputs to the payload build, for the same reason one step earlier: these two files are read by the
# Tailwind compile, so a CRLF version of them would produce a different wireframe-utilities.css and
# the output would stop matching V1 byte for byte.
pipeline/vendor/tailwind/input.css -text
pipeline/vendor/tailwind/safelist.txt -text
pipeline/vendor/pnpm-lock.yaml -text

# Hide what remains of the generated payload from diffs and language statistics, as V1 does.
artifacts/fonts/** linguist-generated=true
artifacts/css/fonts.css linguist-generated=true
pipeline/vendor/pnpm-lock.yaml linguist-generated=true

# The scaffold templates are written verbatim into a user's project, and V1 writes them with LF on
# every platform. Pinning them keeps a scaffolded wireframe identical across operating systems, which
# matters because the leak guard compares runs of copied lines between a wireframe and a repo.
templates/** -text
