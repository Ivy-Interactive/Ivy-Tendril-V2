# The wireframe payload, generated by pipeline/vendor/build-all.mjs.
#
# `-text` disables end-of-line conversion entirely, so these files are stored and checked out as the
# exact bytes the pipeline produced. That is not cosmetic: ARTIFACTS.lock.json records a SHA-256 per
# file, the served bundle is hashed against it, and this repository has no root `.gitattributes` and
# contributors on Windows default to `core.autocrlf=true`. Without this rule every text file in the
# payload would gain CRLF on checkout and every hash in the lock would be wrong.
#
# V1 gets the same guarantee from a repository-wide `* text=auto eol=lf`; scoping it here avoids
# renormalising the rest of V2.
artifacts/** -text

# Inputs to the payload build, for the same reason one step earlier: these two files are read by the
# Tailwind compile, so a CRLF version of them would produce a different wireframe-utilities.css and
# the output would stop matching V1 byte for byte.
pipeline/vendor/tailwind/input.css -text
pipeline/vendor/tailwind/safelist.txt -text
pipeline/vendor/package-lock.json -text

# Hide the generated payload from diffs and language statistics, as V1 does.
artifacts/** linguist-generated=true
pipeline/vendor/package-lock.json linguist-generated=true

# The scaffold templates are written verbatim into a user's project, and V1 writes them with LF on
# every platform. Pinning them keeps a scaffolded wireframe identical across operating systems, which
# matters because the leak guard compares runs of copied lines between a wireframe and a repo.
templates/** -text
