  "samplePrompts": {
    "chat": {
      "review": {
        "label_other": "审查等待中的 {{count}} 个计划",
        "prompt_other": "有 {{count}} 个计划正在等待审查：{{plans}}。请总结每个计划交付的内容，并告诉我应先合并哪一个。"
      },
      "failed": {
        "label": "#{{id}} 为什么失败？",
        "prompt": "计划 #{{id}} {{title}} 失败了。请阅读它的日志和验证报告，并解释出了什么问题。"
      },
      "blocked": {
        "label": "是什么阻塞了 #{{id}}？",
        "prompt": "计划 #{{id}} {{title}} 已阻塞。请列出它所依赖的计划，以及每个计划还需要完成什么。"
      },
      "jobs": {
        "label": "我的任务在做什么？",
        "prompt_other": "有 {{count}} 个任务正在运行。请总结每个任务正在处理的内容。"
      },
      "addProject": {
        "label": "添加新项目",
        "prompt": "向我的 Tendril 添加一个新项目"
      },
      "editVerifications": {
        "label": "编辑验证",
        "prompt": "编辑我的项目的验证"
      },
      "teamVault": {
        "label": "创建团队保管库",
        "prompt": "创建一个共享的团队保管库"
      },
      "nextWork": {
        "label": "接下来我该做什么？",
        "prompt": "查看我所有项目中的草稿计划，推荐接下来应执行的两个，并说明理由。"
      },
      "shipped": {
        "label": "本周交付了什么？",
        "prompt": "按项目分组，总结最近七天内达到 {{state}} 状态的计划。"
      }
    },
    "plan": {
      "failedVerification": {
        "label": "{{name}} 为什么失败？",
        "prompt": "此计划的 {{name}} 验证失败了。请阅读 {{report}} 中的报告，解释失败原因以及如何修复。"
      },
      "prFeedback": {
        "label": "总结 PR 反馈",
        "prompt": "阅读 {{pr}} 上的审查评论，并列出其中要求的修改。"
      },
      "blocked": {
        "label": "是什么阻塞了它？",
        "prompt": "此计划被 {{dependencies}} 阻塞。请告诉我每个依赖项还需要完成什么。"
      },
      "tightenScope": {
        "label": "收紧范围",
        "prompt": "阅读此计划的最新修订版本，指出任何超出范围或描述不够明确的内容。"
      },
      "explainSolution": {
        "label": "解释解决方案",
        "prompt": "用通俗的语言解释此计划的 {{section}} 部分，并列出它将涉及的每个文件。"
      },
      "risks": {
        "label": "可能会出什么问题？",
        "prompt": "此计划中风险最高的部分是什么？审查时我应该检查哪些内容？"
      }
    }
  },
