{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tendril",
  "version": "0.1.0",
  "identifier": "com.spacecorps.tendril.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tendril",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://127.0.0.1:* wss://127.0.0.1:*; frame-src 'self' http://127.0.0.1:* http://localhost:*; img-src 'self' data:; font-src 'self'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "externalBin": ["binaries/tendril", "binaries/opencode"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IFRlbmRyaWxSZWxlYXNlCklVTU11c1U2NTR5aXRyVGlpY1Q5bDVmQ2Z0S0x3c3p5Smlad29LNDV0R2c9Cg==",
      "endpoints": [
        "https://releases.tendril.spacecorps.dev/desktop/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
