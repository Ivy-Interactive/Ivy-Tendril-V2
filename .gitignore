# Visual regression failure diffs
.storybook/__image_snapshots__/__diff_output__/

# Lychee's response cache, written by `pnpm run check:links`
.lycheecache

# Env files
.env
.env.*
!.env.example

# Local scratch plans
.plan/
/.agents/

# Throwaway probe scripts. These land inside a package root, so an uncommitted one
# fails `pnpm check` on formatting for everyone until it is cleaned up -- which is a
# confusing way to learn that somebody left a scratch file behind.
.tmp-*/
